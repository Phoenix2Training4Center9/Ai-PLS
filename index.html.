    <!-- ======================================
         HOW IT WORKS
    ======================================= -->

    <section
      class="how-it-works"
      id="how-it-works"
    >


      <div class="section-heading">

        <span class="section-label">
          HOW IT WORKS
        </span>


        <h2>

          تعلّم بطريقة أذكى،

          <span>
            وليس أصعب.
          </span>

        </h2>


        <p>

          AI PLS يحوّل هدفك الدراسي إلى نظام تعلم شخصي
          يساعدك على التخطيط والفهم والتدريب والمتابعة.

        </p>

      </div>



      <div class="steps">


        <!-- Step 01 -->

        <article class="step-card">

          <div class="step-number">
            01
          </div>

          <div class="step-icon">
            🎯
          </div>

          <h3>
            حدد هدفك
          </h3>

          <p>

            أخبر AI PLS بما تريد تعلمه والوقت المتاح لديك
            والموعد الذي تريد الوصول فيه إلى هدفك.

          </p>

        </article>



        <!-- Step 02 -->

        <article class="step-card">

          <div class="step-number">
            02
          </div>

          <div class="step-icon">
            📚
          </div>

          <h3>
            أضف مصادرك
          </h3>

          <p>

            أضف ملفاتك وملاحظاتك وروابطك ومصادرك التعليمية
            ليتم تنظيمها داخل مساحة تعلم واحدة.

          </p>

        </article>



        <!-- Step 03 -->

        <article class="step-card">

          <div class="step-number">
            03
          </div>

          <div class="step-icon">
            🧠
          </div>

          <h3>
            دع الذكاء الاصطناعي يساعدك
          </h3>

          <p>

            احصل على شروحات وتلخيصات وأسئلة واختبارات
            وخطط دراسة مبنية على احتياجاتك.

          </p>

        </article>



        <!-- Step 04 -->

        <article class="step-card">

          <div class="step-number">
            04
          </div>

          <div class="step-icon">
            📈
          </div>

          <h3>
            تابع تطورك
          </h3>

          <p>

            راقب تقدمك واكتشف نقاط ضعفك
            وعدّل خطتك باستمرار لتحصل على أفضل نتيجة.

          </p>

        </article>

      </div>

    </section>



    <!-- ======================================
         FEATURES
    ======================================= -->

    <section
      class="section"
      id="features"
    >


      <div class="section-heading">

        <div class="eyebrow">
          POWERFUL FEATURES
        </div>


        <h2>
          كل ما تحتاجه للتعلم
          <span class="gradient-text">
            في مكان واحد.
          </span>
        </h2>


        <p>

          بدلاً من استخدام عشرات الأدوات المختلفة،
          يجمع AI PLS أهم أدوات التعلم داخل تجربة واحدة
          مصممة حول احتياجات الطالب.

        </p>

      </div>



      <div class="features">


        <!-- Feature -->

        <article class="feature">

          <div class="feature-icon">
            🗓️
          </div>

          <h3>
            التخطيط الذكي
          </h3>

          <p>

            أنشئ خطة دراسة تناسب أهدافك،
            وقتك، ومستواك الحالي.

          </p>

        </article>



        <article class="feature">

          <div class="feature-icon">
            🧠
          </div>

          <h3>
            شرح ذكي
          </h3>

          <p>

            احصل على شرح للمفاهيم بطريقة تناسب
            مستواك وطريقة تعلمك.

          </p>

        </article>



        <article class="feature">

          <div class="feature-icon">
            📝
          </div>

          <h3>
            تلخيص المحتوى
          </h3>

          <p>

            حوّل المحتوى الطويل إلى ملخصات
            منظمة وسهلة المراجعة.

          </p>

        </article>



        <article class="feature">

          <div class="feature-icon">
            🎯
          </div>

          <h3>
            اختبارات ذكية
          </h3>

          <p>

            أنشئ أسئلة واختبارات مبنية على
            المحتوى الذي تدرسه.

          </p>

        </article>



        <article class="feature">

          <div class="feature-icon">
            📊
          </div>

          <h3>
            تحليل التقدم
          </h3>

          <p>

            اكتشف مستوى تقدمك ونقاط القوة
            والجوانب التي تحتاج إلى مراجعة.

          </p>

        </article>



        <article class="feature">

          <div class="feature-icon">
            📚
          </div>

          <h3>
            تنظيم المصادر
          </h3>

          <p>

            اجمع ملفاتك وروابطك وملاحظاتك
            داخل مساحة تعلم واحدة.

          </p>

        </article>

      </div>

    </section>



    <!-- ======================================
         AI SECTION
    ======================================= -->

