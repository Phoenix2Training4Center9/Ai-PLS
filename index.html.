          </a>

        </div>


        <p class="hero-note">

          ✦ منصة واحدة تجمع أدوات التعلم التي تحتاجها.

        </p>

      </div>



      <!-- ====================================
           PRODUCT PREVIEW
      ===================================== -->

      <div class="preview-wrapper">

        <div class="glow"></div>


        <div class="dashboard-preview">


          <!-- Window Bar -->

          <div class="window-bar">

            <span class="window-dot"></span>
            <span class="window-dot"></span>
            <span class="window-dot"></span>

            <span class="window-title">
              AI PLS Dashboard
            </span>

          </div>



          <!-- Dashboard -->

          <div class="dashboard">


            <!-- Dashboard Header -->

            <div class="dashboard-top">

              <div class="dashboard-title">

                <h3>
                  لوحة التعلم
                </h3>

                <p>
                  مرحباً بك في AI PLS
                </p>

              </div>


              <div class="avatar">
                AI
              </div>

            </div>



            <!-- Statistics -->

            <div class="stats">


              <div class="stat">

                <div class="stat-icon">
                  📚
                </div>

                <strong>
                  12
                </strong>

                <small>
                  درس مكتمل
                </small>

              </div>


              <div class="stat">

                <div class="stat-icon">
                  🎯
                </div>

                <strong>
                  78%
                </strong>

                <small>
                  نسبة التقدم
                </small>

              </div>


              <div class="stat">

                <div class="stat-icon">
                  🔥
                </div>

                <strong>
                  7
                </strong>

                <small>
                  أيام متتالية
                </small>

              </div>

            </div>



            <!-- AI Card -->

            <div class="ai-card">


              <div class="ai-card-top">

                <div class="ai-icon">
                  ✦
                </div>

                <strong>
                  مساعد AI PLS
                </strong>

              </div>


              <p>

                بناءً على تقدمك الحالي،
                أنصحك بمراجعة هذا الدرس ثم حل
                مجموعة قصيرة من الأسئلة لتثبيت فهمك.

              </p>

            </div>



            <!-- Progress -->

            <div class="progress-card">


              <div class="progress-header">

                <span>
                  تقدمك اليوم
                </span>

                <span>
                  78%
                </span>

              </div>


              <div class="progress-track">

                <div class="progress-value"></div>

              </div>

            </div>

          </div>

